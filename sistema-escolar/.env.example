PORT=8787
DATABASE=data/sistema.db
NATIVE_BIN=build/sistema_service
AI_ENABLED=false
LAYA_URL=http://127.0.0.1:8081/v1/chat/completions
LAYA_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
OLLAMA_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
WHISPER_MODEL=models/ggml-base.bin
FACE_MODEL=models/w600k_mbf.onnx
FACE_THRESHOLD=0.55
FACE_MARGIN=0.08
ALLOW_WEB_REFERENCES=true
# Se genera automáticamente al instalar. Respalda esta clave junto con la BD.
BIOMETRIC_KEY=
MEMORY_BUDGET_GIB=12.5
BIND_HOST=127.0.0.1
# Para participantes en red, consulta la sección TLS de INSTALACION.md.
# PUBLIC_ORIGIN=https://campus.institucion.local:8787
# TLS_CERT=certs/campus.pem
# TLS_KEY=certs/campus-key.pem
