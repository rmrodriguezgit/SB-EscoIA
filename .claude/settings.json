{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "out=$(\"$CLAUDE_PROJECT_DIR/scripts/autosync.sh\" 2>&1); [ -n \"$out\" ] && jq -n --arg m \"$out\" '{systemMessage: (\"EscoIA · \" + $m)}' || true",
            "timeout": 90,
            "statusMessage": "Commit y push automáticos de EscoIA"
          }
        ]
      }
    ]
  }
}
